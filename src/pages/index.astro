---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeriesMark from '../components/SeriesMark.astro';
import { dayPath, extensionPath, getContentIndex, isPublished } from '../lib/posts';
import { loadProjectConfigSync } from '../../scripts/ithome/config.mjs';
const { ironman, extensions } = await getContentIndex();
const project = loadProjectConfigSync();
const { publication, site, learningMap } = project;
const base = import.meta.env.BASE_URL;
const publishedCount = ironman.filter((post) => isPublished(post)).length;
const publishedExtensions = extensions.filter((post) => isPublished(post));
const storageKey = `${publication.seriesKey}:last-read`;
---
<BaseLayout title={publication.seriesTitle}>
  <div class="reader-layout">
    <aside class="series-sidebar">
      <a class="sidebar-brand" href={base} aria-current="page"><SeriesMark /><span><strong>{publication.seriesTitle}</strong><small>{site.tagline}</small></span></a>
      <div class="sidebar-heading"><h2><a href={base} aria-current="page">{learningMap.title}</a></h2><p>目前已公開 {publishedCount} 篇。{learningMap.description}</p></div>
      <div class="mobile-series-context">
        <span><strong>{publishedCount}</strong>／{publication.totalDays} 篇已公開</span>
        <details class="mobile-series-directory">
          <summary>文章列表</summary>
          <nav aria-label={`手機版 ${publication.totalDays} 天系列文章`}>
            {learningMap.sections.map((section, index) => {
              const items = ironman.filter((item) => item.data.section === section.id);
              return <section class="sidebar-part"><h3>{learningMap.sectionLabel} {index + 1} <span>｜</span> {section.title}</h3><ol>
                {items.map((item) => <li class:list={[{ locked: !isPublished(item) }]}>
                  {isPublished(item) ? <a href={`${base}${dayPath(item.data.day).slice(1)}`}><span class="day-chip">Day {String(item.data.day).padStart(2, '0')}</span><span class="sidebar-title">{item.data.title.replace(/^Day\s*\d+｜/, '')}</span><time>{item.data.publishDate.toLocaleDateString('zh-TW')}</time></a> : <div class="locked-row"><span class="day-chip">Day {String(item.data.day).padStart(2, '0')}</span><span class="sidebar-title">{item.data.title.replace(/^Day\s*\d+｜/, '')}</span></div>}
                </li>)}
              </ol></section>;
            })}
          </nav>
        </details>
      </div>
      <nav class="series-tree" aria-label={`${publication.totalDays} 天系列文章`}>
        {learningMap.sections.map((section, index) => {
          const items = ironman.filter((item) => item.data.section === section.id);
          return <section class="sidebar-part"><h3>{learningMap.sectionLabel} {index + 1} <span>｜</span> {section.title}</h3><ol>
            {items.map((item) => <li class:list={[{ locked: !isPublished(item) }]}>
              {isPublished(item) ? <a href={`${base}${dayPath(item.data.day).slice(1)}`}><span class="day-chip">Day {String(item.data.day).padStart(2, '0')}</span><span class="sidebar-title">{item.data.title.replace(/^Day\s*\d+｜/, '')}</span><time>{item.data.publishDate.toLocaleDateString('zh-TW')}</time></a> : <div class="locked-row"><span class="day-chip">Day {String(item.data.day).padStart(2, '0')}</span><span class="sidebar-title">{item.data.title.replace(/^Day\s*\d+｜/, '')}</span></div>}
            </li>)}
          </ol></section>;
        })}
      </nav>
    </aside>
    <main class="reading-pane guide-pane">
      <article class="series-guide">
        <p class="guide-kicker">{site.home.kicker}</p><h1>{publication.seriesTitle}</h1><p class="guide-lead">{site.home.lead}</p><p class="guide-summary">{site.home.summary}</p>
        <a id="resume-reading" class="resume-reading" href="#" hidden><span class="resume-label">繼續上次閱讀</span><strong id="resume-title"></strong><span id="resume-day"></span><span class="resume-arrow">繼續閱讀 →</span></a>
        <section class="guide-parts"><div class="guide-section-heading"><span>共 {learningMap.sections.length} 個{learningMap.sectionLabel}</span><h2>{learningMap.sectionHeading}</h2></div>
          {learningMap.sections.map((section, index) => { const count = ironman.filter((item) => item.data.section === section.id).length; return <div class="guide-part-row"><span class="guide-part-number">{learningMap.sectionLabel} {index + 1}</span><div><h3>{section.title}</h3><p>{section.description}（{count} 篇）</p></div></div>; })}
        </section>
        {project.extensions.enabled && publishedExtensions.length > 0 && <section class="extension-list"><p class="guide-kicker">{project.extensions.title}</p><h2>{project.extensions.description}</h2>{publishedExtensions.map((item) => <a class="extension-card" href={`${base}${extensionPath(item.data.slug).slice(1)}`}><time>{item.data.publishDate.toLocaleDateString('zh-TW')}</time><strong>{item.data.title}</strong><span>{item.data.description}</span></a>)}</section>}
      </article>
    </main>
  </div>
  <script is:inline define:vars={{ storageKey }}>try { const saved = JSON.parse(localStorage.getItem(storageKey) || 'null'); if (saved?.href && saved?.title && saved?.day) { const card = document.getElementById('resume-reading'); if (card) { card.href = saved.href; card.hidden = false; document.getElementById('resume-title').textContent = saved.title; document.getElementById('resume-day').textContent = `Day ${String(saved.day).padStart(2, '0')}`; } } } catch (_) {}</script>
</BaseLayout>
