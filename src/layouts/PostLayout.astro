---
import BaseLayout from './BaseLayout.astro';
import SeriesMark from '../components/SeriesMark.astro';
import { dayPath, getAllPosts, isPublished, type IronmanPost } from '../lib/posts';
import { loadProjectConfigSync } from '../../scripts/ithome/config.mjs';

interface Props { post: IronmanPost; previous?: IronmanPost; next?: IronmanPost; }
const { post, previous, next } = Astro.props;
const project = loadProjectConfigSync();
const { publication, site, learningMap } = project;
const allPosts = await getAllPosts();
const section = learningMap.sections.find((item) => item.id === post.data.section);
const base = import.meta.env.BASE_URL;
const shortTitle = post.data.title.replace(/^Day\s*\d+｜/, '');
const lastRead = { day: post.data.day, title: shortTitle, href: `${base}${dayPath(post.data.day).slice(1)}` };
---
<BaseLayout title={post.data.title} description={post.data.description ?? post.data.title}>
  <div class="reader-layout">
    <aside class="series-sidebar">
      <a class="sidebar-brand" href={base}>
        <SeriesMark />
        <span><strong>{publication.seriesTitle}</strong><small>{site.tagline}</small></span>
      </a>

      <div class="sidebar-heading">
        <h2><a href={base}>第 {post.data.day} 天，共 {publication.totalDays} 天</a></h2>
        <p>你正在「{section?.title}」，可以隨時從下方切換文章。</p>
        <div class="reading-progress" role="progressbar" aria-label={`${publication.totalDays} 天系列閱讀進度`} aria-valuemin="1" aria-valuemax={publication.totalDays} aria-valuenow={post.data.day}>
          <span style={`--progress: ${(post.data.day / publication.totalDays) * 100}%`}></span>
        </div>
      </div>

      <div class="mobile-series-context">
        <span><strong>Day {post.data.day}</strong>／{publication.totalDays} · {section?.title}</span>
        <details class="mobile-series-directory">
          <summary>系列目錄</summary>
          <nav aria-label={`手機版 ${publication.totalDays} 天系列文章`}>
            {learningMap.sections.map((mapSection, index) => (
              <section class="sidebar-part">
                <h3>{learningMap.sectionLabel} {index + 1} <span>｜</span> {mapSection.title}</h3>
                <ol>{allPosts.filter((item) => item.data.section === mapSection.id).map((item) => {
                  const published = isPublished(item);
                  const active = item.data.day === post.data.day;
                  const label = item.data.title.replace(/^Day\s*\d+｜/, '');
                  return <li class:list={[{ active, locked: !published && !active }]}>{published || active ? (
                    <a href={`${base}${dayPath(item.data.day).slice(1)}`} aria-current={active ? 'page' : undefined}>
                      <span class="day-chip">Day {String(item.data.day).padStart(2, '0')}</span><span class="sidebar-title">{label}</span><time>{item.data.publishDate.toLocaleDateString('zh-TW', { timeZone: 'Asia/Taipei' })}</time>
                    </a>
                  ) : <div class="locked-row"><span class="day-chip">Day {String(item.data.day).padStart(2, '0')}</span><span class="sidebar-title">{label}</span></div>}</li>;
                })}</ol>
              </section>
            ))}
          </nav>
        </details>
      </div>

      <nav class="series-tree" aria-label={`${publication.totalDays} 天系列文章`}>
        {learningMap.sections.map((mapSection, index) => (
          <section class="sidebar-part">
            <h3>{learningMap.sectionLabel} {index + 1} <span>｜</span> {mapSection.title}</h3>
            <ol>{allPosts.filter((item) => item.data.section === mapSection.id).map((item) => {
              const published = isPublished(item);
              const active = item.data.day === post.data.day;
              const label = item.data.title.replace(/^Day\s*\d+｜/, '');
              return <li class:list={[{ active, locked: !published && !active }]}>{published || active ? (
                <a href={`${base}${dayPath(item.data.day).slice(1)}`} aria-current={active ? 'page' : undefined}>
                  <span class="timeline-dot" aria-hidden="true"></span><span class="day-chip">Day {String(item.data.day).padStart(2, '0')}</span><span class="sidebar-title">{label}</span><time>{item.data.publishDate.toLocaleDateString('zh-TW', { timeZone: 'Asia/Taipei' })}</time>
                </a>
              ) : <div class="locked-row"><span class="timeline-dot" aria-hidden="true"></span><span class="day-chip">Day {String(item.data.day).padStart(2, '0')}</span><span class="sidebar-title">{label}</span></div>}</li>;
            })}</ol>
          </section>
        ))}
      </nav>
    </aside>

    <main class="reading-pane"><article class="article-shell">
      <div class="article-meta"><span class="article-day">Day {String(post.data.day).padStart(2, '0')}</span><span>{section?.title}</span><time>{post.data.publishDate.toLocaleDateString('zh-TW', { timeZone: 'Asia/Taipei' })}</time></div>
      <h1>{shortTitle}</h1><p class="part-title">{section?.description}</p><div class="prose"><slot /></div>
      {post.data.ithomeUrl && <p class="ithome-link"><a href={post.data.ithomeUrl}>在 iThome 閱讀同步版本 ↗</a></p>}
      <nav class="post-nav" aria-label="文章導覽"><div>{previous && <a href={`${base}${dayPath(previous.data.day).slice(1)}`}><small>← 上一篇</small><strong>{previous.data.title.replace(/^Day\s*\d+｜/, '')}</strong></a>}</div><div>{next && <a href={`${base}${dayPath(next.data.day).slice(1)}`}><small>下一篇 →</small><strong>{next.data.title.replace(/^Day\s*\d+｜/, '')}</strong></a>}</div></nav>
    </article></main>
  </div>
  <script is:inline define:vars={{ lastRead, storageKey: `${publication.seriesKey}:last-read` }}>try { localStorage.setItem(storageKey, JSON.stringify(lastRead)); } catch (_) {}</script>
</BaseLayout>
